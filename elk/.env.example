# Copy to .env (gitignored) and adjust for the machine's ELK stack.
# Both docker-compose.yml and setup.sh read this file.

# Must match the running stack's version (beats major.minor <= ES).
ELASTIC_VERSION=9.4.2

ES_HOST=http://localhost:9200
KIBANA_HOST=http://localhost:5601
ES_USER=elastic
ES_PASSWORD=changeme
