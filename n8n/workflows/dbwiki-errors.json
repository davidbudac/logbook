   "typeVersion": 3.4,
   "position": [
    240,
    0
   ]
  },
  {
   "parameters": {
    "authentication": "privateKey",
    "command": "export PATH=/usr/local/bin:/usr/bin:/bin; cd /opt/logbook && mkdir -p .state/n8n && cat >> .state/n8n/events.jsonl <<'EOF'\n{{ $json.line }}\nEOF",
    "cwd": "/opt/logbook"
   },
   "name": "Append to .state/n8n/events.jsonl",
